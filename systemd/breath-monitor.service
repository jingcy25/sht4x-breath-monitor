[Unit]
Description=AP30023 Breath Monitor (integration branch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sht4x-breath-monitor
ExecStart=/usr/bin/python3 -u /home/pi/sht4x-breath-monitor/breath_server.py --port 8000 --sleep-onset 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
